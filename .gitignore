cat > .gitignore <<'EOF'
# Environment variables / secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
**/node_modules/

# Next.js
.next/
out/

# Build / coverage
dist/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
EOF