# ==========================
# SERVER
# ==========================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ==========================
# DATABASE (PostgreSQL - raw SQL, no ORM)
# ==========================
DATABASE_URL=postgresql://user:password@localhost:5432/flight_optimizer
PG_SSL=false

# ==========================
# JWT
# ==========================
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ==========================
# OAUTH
# ==========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ==========================
# FLIGHT PROVIDER
# ==========================
FLIGHT_PROVIDER=mock
# mock | amadeus | ignav
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Ignav (https://ignav.com) — real, live flight fares AND the primary
# airport search/autocomplete source (GET /api/airports). One key covers
# both: Ignav's API applies a single X-Api-Key scheme across the whole
# service. First 1,000 requests are free, then $2 per 1,000 successful
# requests; failed requests are never billed. Get a key at
# https://ignav.com/signup. Backend-only — never expose this as a
# NEXT_PUBLIC_* variable.
IGNAV_API_KEY=your_ignav_api_key
IGNAV_BASE_URL=https://ignav.com/api
# 2-letter market/country code controlling result currency (IN -> INR fares,
# matching this app's INR-only price display with no client-side conversion).
IGNAV_MARKET=IN

# ==========================
# AI (provider-agnostic — set AI_PROVIDER to switch)
# ==========================
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ==========================
# WEATHER
# ==========================
OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL_MINUTES=30

# ==========================
# GOOGLE PLACES (New) - hotels/restaurants near a destination.
# Only "Places API (New)" needs to be enabled — no Geocoding API required,
# since we already have lat/lon for every airport in our own dataset.
# ==========================
GOOGLE_PLACES_API_KEY=
PLACES_CACHE_TTL_HOURS=24

# ==========================
# BUDGET OPTIMIZER
# Rough per-traveler-per-day living cost range (hotel + food + local travel)
# used to estimate whether a trip's budget is comfortable/tight beyond just
# the flight price. Not destination-specific — a general planning heuristic,
# not real pricing data (no hotel/food pricing API is configured).
# ==========================
BUDGET_DAILY_MIN_INR=1500
BUDGET_DAILY_MAX_INR=4000

# ==========================
# PAYMENTS
# ==========================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==========================
# EMAIL
# ==========================
RESEND_API_KEY=
EMAIL_FROM=noreply@flightoptimizer.app

# ==========================
# OPTIMIZER CONSTRAINTS
# ==========================
MAX_NEARBY_AIRPORTS=3
MAX_DATE_FLEX_DAYS=3
MAX_PERMUTATIONS=500
MAX_COUNTRIES_PER_TRIP=4

# ==========================
# SENTRY (error monitoring — optional, safe to leave blank)
# Leave SENTRY_DSN blank to disable Sentry entirely; nothing else changes.
# ==========================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Explicit kill switch — set to 'false' to force-disable even if a DSN is set.
SENTRY_ENABLED=true

# ==========================
# CACHE
# ==========================
FLIGHT_CACHE_TTL_MINUTES=20
STATIC_CACHE_TTL_HOURS=24

# ==========================
# REDIS (optional — accelerates the flight cache across instances)
# Leave blank to run entirely on the existing Postgres flight_cache table
# and in-memory caches; nothing else changes if REDIS_URL is unset.
# Local dev: redis://localhost:6379
# Managed (e.g. Upstash, Render Key Value, Redis Cloud): use the provided
# rediss:// (TLS) connection string.
# ==========================
REDIS_URL=
